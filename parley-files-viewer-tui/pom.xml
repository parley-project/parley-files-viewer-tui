<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- License, developer, SCM, URL, GitHub Packages and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>2.0.0-SNAPSHOT</version>
		<relativePath>../../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-viewer-tui</artifactId>
	<name>Parley Files Viewer TUI</name>
	<description>parley-files-viewer without a GUI: a full-screen terminal (text UI) application for
		browsing, copying, searching and editing files on any parley-files file system (local, memory,
		SFTP, FTP, JDBC), on parley-term. Also an fsh plugin: the terminal browser for fsh's browse, and
		the view, edit and search commands.</description>

	<!-- The repository is parley-files-viewer-tui (this module is in it, with the Lanterna browser) -->

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.viewer.tui</parley.moduleName>
		<parley.tui.mainClass>us.bringardner.parley.files.viewer.tui.termui.TermMain</parley.tui.mainClass>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>${parley.tui.mainClass}</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<!-- target/parley-files-viewer-tui-VERSION-all.jar: run with java -jar (pfv). The plain jar
			     is the library fsh builds its browse, view, edit and search on. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>all</shadedClassifierName>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<!-- keeps every module's FileSourceFactory registration -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${parley.tui.mainClass}</mainClass>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/*/module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- META-INF/parley/launcher.list in the jar: how parley-launcher runs it, and every jar it
			     needs with its SHA-256 (parley-launcher add NAME COORDINATES [MAIN]) -->
			<plugin>
				<groupId>us.bringardner.parley</groupId>
				<artifactId>parley-launcher-maven-plugin</artifactId>
				<version>${project.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>list</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- (pfv: parley-launcher add pfv us.bringardner.parley:parley-files-viewer-tui:VERSION) -->
					<mainClass>${parley.tui.mainClass}</mainClass>
					<options>
						<option>17+:--enable-native-access=ALL-UNNAMED</option>
					</options>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-io</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<!-- FileSource, the factories and the toolkit-neutral browse package -->
			<artifactId>parley-files</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- parley-files-sftp has no SSH library of its own: the provider for Parley's own one, which it
		     prefers when it's there (JSch or MINA could be added instead) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp-parley-ssh</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>
		<!-- FTP and FTPS file systems; found at run time like the others -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-ftp</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-jdbc</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<!-- The terminal and the full-screen toolkit -->
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-term</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
